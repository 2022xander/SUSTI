<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CREAR UN CUADRADO Y UN TRIÁNGULO</title>
</head>
<body>

    <h2>CREAR UN CUADRADO Y UN TRIÁNGULO</h2>
    <h2>Realizado Alexander Marocho Huaman</h2>
    
    <canvas id="myCanvas" width="500" height="500" style="border:4px solid black;"></canvas>

    <script>
        var canvas = document.getElementById("myCanvas");
        var ctx = canvas.getContext("2d");

        // =====================
        // MARCO GRANDE
        // =====================
        ctx.beginPath();
        ctx.rect(10, 10, 480, 480);
        ctx.strokeStyle = "green";
        ctx.stroke();

        // =====================
        // LÍNEA HORIZONTAL
        // =====================
        ctx.beginPath();
        ctx.moveTo(10, 250);
        ctx.lineTo(490, 250);
        ctx.strokeStyle = "green";
        ctx.stroke();

        // =====================
        // CUADRADO (ARRIBA)
        // =====================
        ctx.beginPath();
        ctx.rect(200, 80, 100, 100);
        ctx.strokeStyle = "blue";
        ctx.stroke();

        // =====================
        // TRIÁNGULO (ABAJO)
        // =====================
        ctx.beginPath();
        ctx.moveTo(250, 300);  // vértice superior
        ctx.lineTo(180, 400);  // base izquierda
        ctx.lineTo(320, 400);  // base derecha
        ctx.closePath();
        ctx.strokeStyle = "blue";
        ctx.stroke();

    </script>

</body>
</html>
